<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Для Настюни ❤️</title>
<style>
  :root {
    --bg: #0b0714;
    --card: rgba(255,255,255,.08);
    --border: rgba(255,255,255,.14);
    --text: #fff7fb;
    --muted: rgba(255,247,251,.68);
    --accent: #ff6b9a;
    --accent2: #ff9a6b;
  }

  * { box-sizing: border-box; }

  html, body { min-height: 100%; }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    color: var(--text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(circle at 18% 18%, rgba(130, 60, 150, .45), transparent 34%),
      radial-gradient(circle at 82% 76%, rgba(255, 107, 154, .28), transparent 34%),
      radial-gradient(circle at 50% 0%, rgba(255, 154, 107, .16), transparent 40%),
      var(--bg);
    overflow-x: hidden;
  }

  main { width: min(720px, 100%); position: relative; z-index: 2; }

  .screen {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    padding: clamp(24px, 5vw, 48px);
    border: 1px solid var(--border);
    border-radius: 32px;
    background: rgba(20, 10, 30, .58);
    box-shadow: 0 30px 80px rgba(0,0,0,.35);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .screen.active { display: flex; animation: fadeUp .65s ease both; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  h1, h2 { margin: 0; line-height: 1.15; letter-spacing: -.02em; }
  h1 { font-size: clamp(30px, 6vw, 52px); }
  h2 { font-size: clamp(26px, 5vw, 40px); }
  p { margin: 0; }

  .muted { color: var(--muted); font-size: clamp(15px, 2.8vw, 18px); line-height: 1.55; }

  .envelope {
    font-size: clamp(64px, 14vw, 100px);
    animation: float 3.2s ease-in-out infinite;
    filter: drop-shadow(0 18px 30px rgba(255,107,154,.25));
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-12px) rotate(3deg); }
  }

  button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    padding: 15px 30px;
    color: #2a0f1a;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    font: inherit;
    font-weight: 800;
    font-size: 16px;
    cursor: pointer;
    box-shadow: 0 14px 34px rgba(255,107,154,.28);
    transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease;
  }

  button:hover { transform: translateY(-2px) scale(1.02); box-shadow: 0 18px 42px rgba(255,107,154,.38); }
  button:active { transform: translateY(0) scale(.99); }
  button:disabled { opacity: .65; cursor: default; transform: none; }

  /* Второстепенная кнопка (прозрачная) */
  .btn-secondary {
    background: transparent;
    border: 2px solid var(--accent);
    color: var(--accent);
    box-shadow: none;
    padding: 12px 24px;
    font-size: 15px;
  }
  .btn-secondary:hover {
    background: rgba(255,107,154,.1);
    box-shadow: 0 4px 15px rgba(255,107,154,.2);
  }

  .story-text {
    min-height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(21px, 4.4vw, 32px);
    line-height: 1.42;
    font-weight: 650;
    letter-spacing: -.01em;
  }

  .cards { width: 100%; display: grid; gap: 12px; text-align: left; }

  .card {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--card);
    animation: cardIn .55s ease both;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .card h3 { margin: 0 0 7px; font-size: 17px; color: #ffd7e4; }
  .card p { color: var(--muted); line-height: 1.5; font-size: 15px; }

  /* Стили для галереи 2x2 */
  .gallery-grid {
    width: 100%; max-width: 600px; display: grid; grid-template-columns: 1fr 1fr;
    gap: 12px; margin: 15px 0; animation: fadeUp .8s ease both;
  }
  .gallery-grid img {
    width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover;
    object-position: center 20%; border-radius: 16px; border: 1px solid rgba(255,107,154,.35);
    box-shadow: 0 8px 24px rgba(0,0,0,.35); transition: transform .25s ease, filter .25s ease;
    filter: contrast(1.05) saturate(1.1);
  }
  .gallery-grid img:hover {
    transform: scale(1.03);
    filter: contrast(1.1) saturate(1.2);
  }

  .final-text { max-width: 560px; font-size: clamp(19px, 3.5vw, 26px); line-height: 1.5; }
  .signature { font-style: italic; color: #ffd7e4; font-size: 18px; }
  
  /* БЛОК СЕКРЕТА И КОМПЛИМЕНТОВ */
  .final-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 18px; /* Идеальное расстояние между элементами */
    margin-top: 10px;
  }

  .secret {
    max-width: 560px; 
    width: 100%;
    padding: 16px 18px; 
    border-radius: 18px;
    background: rgba(255,107,154,.12); 
    border: 1px solid rgba(255,107,154,.25);
    color: #ffe4ec; 
    line-height: 1.55; 
    font-size: 16px;
  }

  .compliment-box {
    max-width: 500px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 2px 10px rgba(255,107,154,.4);
    transition: opacity 0.3s ease;
    line-height: 1.4;
    min-height: 40px;
  }

  .hidden { display: none !important; }

  .heart-particle {
    position: fixed; top: -10vh; z-index: 1; pointer-events: none;
    animation-name: heartFall; animation-timing-function: linear; animation-fill-mode: forwards;
  }

  @keyframes heartFall {
    to { transform: translateY(120vh) rotate(360deg); opacity: 0; }
  }

  @media (max-width: 480px) {
    body { padding: 12px; }
    .screen { border-radius: 24px; gap: 18px; }
    .story-text { min-height: 170px; }
    .gallery-grid { gap: 6px; }
    .gallery-grid img { border-radius: 12px; }
  }
</style>
</head>
<body>

<!-- ПУТЬ К ПЕСНЕ В ПАПКЕ music -->
<audio id="bgMusic" loop>
    <source src="music/song.mp3" type="audio/mpeg">
</audio>

<main>
  <section id="screen-intro" class="screen active">
    <div class="envelope">💌</div>
    <h1>Для тебя, <span id="partnerName">Настюня</span></h1>
    <p class="muted">Это не просто ссылка. Нажми, когда будет минутка и никто не будет отвлекать.</p>
    <button id="startBtn">Открыть</button>
  </section>

  <section id="screen-story" class="screen">
    <p id="storyText" class="story-text" aria-live="polite"></p>
    <button id="nextBtn">Дальше →</button>
  </section>

  <section id="screen-reasons" class="screen">
    <h2>Пять причин</h2>
    <p class="muted">Почему ты — мой человек</p>
    
    <!-- ПУТИ К ФОТО В ПАПКЕ images -->
    <div class="gallery-grid">
      <img src="images/5.jpg" alt="Фото 1">
      <img src="images/6.jpg" alt="Фото 2">
      <img src="images/7.jpg" alt="Фото 3">
      <img src="images/8.jpg" alt="Фото 4">
    </div>

    <div id="cards" class="cards"></div>
    <button id="finalBtn">И последнее...</button>
  </section>

  <section id="screen-final" class="screen">
    <h2>Самое главное</h2>
    <p id="finalText" class="final-text"></p>
    <p id="signature" class="signature"></p>
    
    <div class="final-actions">
        <button id="heartBtn">Нажми сюда ❤️</button>
        <p id="secretMessage" class="secret hidden"></p>
        <div class="compliment-box" id="complimentDisplay"></div>
        <button id="moreComplimentsBtn" class="btn-secondary hidden">Еще комплименты ✨</button>
    </div>
  </section>
</main>

<script>
  /* ====== ЗАМЕНИ ЭТО ПОД СЕБЯ ====== */
  const PARTNER_NAME = "Настюня";
  const YOUR_NAME = "Твой Вадим"; 

  const story = [
    `Привет, Настюня. Если ты это открыла — значит, я всё-таки решился.`,
    "Я не мастер громких слов, но ради тебя готов свернуть горы (или хотя бы написать пару строк кода).",
    "Помнишь озеро Тургояк? Именно там всё началось. С тех пор я понял, что пропал.",
    "И да, я специально сделал кнопку. Нажми её — там самое важное."
  ];

  const reasons = [
    { title: "1. Твоя улыбка", text: "Она у тебя просто прекрасная. Такая искренняя, что когда ты улыбаешься, я забываю, о чем вообще говорил." },
    { title: "2. Глаза как океан", text: "Я серьезно. В них можно утонуть, и я совершенно не против. Самый красивый океан в мире." },
    { title: "3. Твой ум", text: "Ты не просто красивая, ты невероятно умная. Твои советы и мысли всегда попадают в точку. С тобой я становлюсь лучше." },
    { title: "4. Заразительный смех", text: "Твой смех — это отдельный вид искусства. Когда ты смеешься, начинаю улыбаться и я. Это невозможно контролировать." },
    { title: "5. Твоя талия...", text: "Просто что-то с чем-то. Ты сводишь меня с ума своей фигурой, и это чистая правда." }
  ];

  // РАСШИРЕННЫЙ СПИСОК КОМПЛИМЕНТОВ (25 штук)
  const extraCompliments = [
    "Твоя улыбка может осветить даже самый пасмурный день.",
    "Я до сих пор помню тот момент на Тургояке. Это было лучшее знакомство в моей жизни.",
    "Твой ум меня всегда поражает. С тобой можно говорить обо всем на свете.",
    "Я готов слушать твой смех на повтор. Он самый лучший.",
    "Твои глаза — это мой личный океан, в котором я хочу утонуть.",
    "Ты не просто красивая, ты самая красивая девушка во Вселенной.",
    "Мне очень повезло, что ты есть у меня.",
    "Твоя талия... ты сводишь меня с ума, и ты это знаешь.",
    "Ты делаешь меня лучше просто тем, что находишься рядом.",
    "Каждый день с тобой — это подарок.",
    "Ты — мой самый близкий и родной человек.",
    "Я скучаю по тебе, даже если мы не виделись всего пару часов.",
    "С тобой можно молчать, и это молчание самое уютное на свете.",
    "Ты всегда знаешь, как меня поддержать и направить на путь истинный.",
    "Твои волосы пахнут лучше любого парфюма в мире.",
    "Я обожаю твой стиль и то, как ты преподносишь себя.",
    "Ты — причина моей самой искренней улыбки.",
    "Мне нравится, как ты рассуждаешь о жизни. Ты очень мудрая.",
    "Я хочу делать тебя самой счастливой каждый день.",
    "Ты выглядишь потрясающе в любой одежде (и даже без нее, но тсс).",
    "Озеро Тургояк навсегда останется в моем сердце, потому что там я нашел тебя.",
    "Я люблю в тебе абсолютно всё, даже твои вредности.",
    "Ты — мое самое любимое и главное чудо.",
    "Я готов идти за тобой на край света, только скажи."
  ];

  const finalText = "Настюня, с того момента на Тургояке я понял, что ты — та самая. Спасибо тебе за твою Любовь, Заботу и за то, что ты есть. Я тебя очень сильно люблю.";
  const secretMessage = "P.S. Если ты сейчас улыбнулась — значит, я всё сделал не зря. Обнимаю тебя крепко-крепко ❤️";
  /* ====== КОНЕЦ НАСТРОЕК ====== */

  document.getElementById("partnerName").textContent = PARTNER_NAME;
  document.getElementById("finalText").textContent = finalText;
  document.getElementById("signature").textContent = YOUR_NAME;
  document.getElementById("secretMessage").textContent = secretMessage;

  const screens = document.querySelectorAll(".screen");
  const storyText = document.getElementById("storyText");
  const nextBtn = document.getElementById("nextBtn");
  const music = document.getElementById("bgMusic");
  let messageIndex = 0;
  let typing = false;
  let typeTimer = null;

  function showScreen(id) {
    screens.forEach(s => s.classList.remove("active"));
    document.getElementById(id).classList.add("active");
  }

  function typeMessage(index) {
    clearInterval(typeTimer);
    typing = true;
    nextBtn.disabled = true;
    storyText.textContent = "";
    const text = story[index];
    let i = 0;
    typeTimer = setInterval(() => {
      storyText.textContent += text[i] || "";
      i++;
      if (i >= text.length) {
        clearInterval(typeTimer);
        typing = false;
        nextBtn.disabled = false;
        nextBtn.textContent = index === story.length - 1 ? "Показать причины →" : "Дальше →";
      }
    }, 34);
  }

  document.getElementById("startBtn").addEventListener("click", () => {
    music.volume = 0.4;
    if (music.readyState >= 1) {
      music.currentTime = 120; // 2:00
    } else {
      music.addEventListener('loadedmetadata', () => { music.currentTime = 120; }, { once: true });
    }
    music.play().catch(e => console.log("Музыка ждет клика:", e));

    showScreen("screen-story");
    messageIndex = 0;
    typeMessage(0);
  });

  nextBtn.addEventListener("click", () => {
    if (typing) {
      clearInterval(typeTimer);
      storyText.textContent = story[messageIndex];
      typing = false;
      nextBtn.disabled = false;
      nextBtn.textContent = messageIndex === story.length - 1 ? "Показать причины →" : "Дальше →";
      return;
    }
    if (messageIndex < story.length - 1) {
      messageIndex++;
      typeMessage(messageIndex);
    } else {
      showScreen("screen-reasons");
      renderReasons();
    }
  });

  function renderReasons() {
    const cards = document.getElementById("cards");
    cards.innerHTML = reasons.map((reason, i) => `
      <div class="card" style="animation-delay:${i * 0.1}s">
        <h3>${reason.title}</h3>
        <p>${reason.text}</p>
      </div>
    `).join("");
  }

  document.getElementById("finalBtn").addEventListener("click", () => {
    showScreen("screen-final");
    createHearts(18);
  });

  document.getElementById("heartBtn").addEventListener("click", () => {
    document.getElementById("secretMessage").classList.remove("hidden");
    createHearts(45);
    
    const moreBtn = document.getElementById("moreComplimentsBtn");
    moreBtn.classList.remove("hidden");
    
    showRandomCompliment();
  });

  document.getElementById("moreComplimentsBtn").addEventListener("click", () => {
    showRandomCompliment();
    createHearts(10);
  });

  function showRandomCompliment() {
    const display = document.getElementById("complimentDisplay");
    const randomIndex = Math.floor(Math.random() * extraCompliments.length);
    
    display.style.opacity = 0;
    setTimeout(() => {
        display.textContent = extraCompliments[randomIndex];
        display.style.opacity = 1;
    }, 300);
  }

  function createHearts(count = 20) {
    const symbols = ["❤️", "💖", "💕", "✨", "💗"];
    for (let i = 0; i < count; i++) {
      const el = document.createElement("span");
      el.className = "heart-particle";
      el.textContent = symbols[Math.floor(Math.random() * symbols.length)];
      el.style.left = Math.random() * 100 + "vw";
      el.style.fontSize = (14 + Math.random() * 26) + "px";
      el.style.animationDuration = (3 + Math.random() * 3.5) + "s";
      el.style.animationDelay = (Math.random() * 0.8) + "s";
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 7500);
    }
  }
</script>
</body>
</html>
